            "exportData": {
                "resolutionScale": 1.0,
                "rescaleWithOutput": true,
                "windowResolutionScale": 1.0
            },
            "shader": {
                "fragmentSourceSize": 2143,
                "fragmentSource": "uint gSeed = floatBitsToUint(1.389*qc.x) +\n             floatBitsToUint(1.918*qc.y) +\n             0x13891918u*iFrame + uint(0x19181389u*1);\n                            // Base prng for all others, inspired by Murmur1\nfloat prng(inout uint seed) // [Stateless] uint seed -> float in [0, 1]\n{\n    const uint m = 0x5bd1e995u;\n    uint r = seed ^ 4u; seed *= m; seed ^= seed >> 24u; seed*= m;\n    r *= m; r ^= seed; r ^= r >> 11u; r *= m;\n    return float(r)/0xffffffffu;\n}\nfloat prng1() {return prng(gSeed);}\n\nuint countNeighbors(sampler2D s, ivec2 p, ivec2 r)\n{\n    uint count = 0;\n    for (int i=-1; i<=1; i++)\n    {\n        for (int j=-1; j<=1; j++)\n        {\n            if (i == 0 && j == 0)\n                continue;\n            ivec2 pij = p+ivec2(i,j);\n            if (pij.x < 0)\n                pij.x = r.x-1;\n            if (pij.x > r.x-1)\n                pij.x = 0;\n            if (pij.y < 0)\n                pij.y = r.y-1;\n            if (pij.y > r.y-1)\n                pij.y = 0;\n            count += uint(texelFetch(s, pij, 0)+.5);\n        }\n    }\n    return 8-count;\n}\n\nvoid main()\n{\n    vec2 scale = iResolution/iWindowResolution;\n    ivec2 mouse = ivec2(iMouse.xy*scale);\n    if (iFrame == 0)\n    {\n        float v = int(prng1()+.5);\n        fragColor.a = 1;\n        fragColor.rgb = vec3(v);\n    }\n    else\n    {\n        fragColor = texture(self, tc);\n        IF_FRAG_XY(mouse.x, mouse.y)\n        {\n            if (iMouse.z > 0)\n                fragColor.rgb = vec3(0,0,0);\n        }\n        if (iFrame % latency != 0 || pause)\n            return;\n        uint count = countNeighbors(self, ivec2(fragCoord), ivec2(iResolution));\n        // Spice things up :p\n        uint deathThreshold = prng1() < 1.0-deathModifier ? 2 : 1;\n        ssfData[0].r = deathModifier;\n        if (count < deathThreshold)\n            fragColor.rgb = vec3(1);\n        else if (fragColor.r == 1. && count == 3)\n            fragColor.rgb = vec3(0);\n        else if (count > 3)\n            fragColor.rgb = vec3(1);\n        IF_FRAG_XY(mouse.x, mouse.y)\n        {\n            if (iMouse.z > 0)\n                fragColor.rgb = vec3(0,0,0);\n        }\n    }\n}",
                "uniforms": {
                    "self": {
                        "type": "sampler2D",
                        "shared": false,
                        "value": "GOL"
                    },
                    "latency": {
                        "type": "int",
                        "shared": false,
                        "value": 10,
                        "min": 1.0,
                        "max": 50.0
                    },
                    "pause": {
