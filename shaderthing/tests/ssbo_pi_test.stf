                "windowResolutionScale": 1.0
            },
            "shader": {
                "fragmentSourceSize": 1559,
                "fragmentSource": "// Example test case to check the usage of long unsigned int variables (which\n// may require shader extensions, and the GL_NV_GPU_shader5 has been enabled\n// here for this purpose) in the shared storage buffer (ssiData) for a test \n// purpose, namely calculating the value of pi with random sampling (the value\n// can be see in cell index 0 of the ssfData array, see Resources->Shared \n// storage viewer). This is also, this, a quick test for the validity of \n// the random number generator hereby found, although that is a GLSL test and \n// not a ShaderThing-proper test. It converges reasonably quickly to the first\n// 4 digits of pi (3.1415)\n\nuint gSeed = floatBitsToUint(1.389*qc.x) +\n             floatBitsToUint(1.918*qc.y) +\n             0x13891918u*iFrame + 0x19181389u*iRenderPass;\n                            // Base prng for all others, inspired by Murmur1\nfloat prng(inout uint seed) // [Stateless] uint seed -> float in [0, 1]\n{\n    const uint m = 0x5bd1e995u;\n    uint r = seed ^ 4u; seed *= m; seed ^= seed >> 24u; seed*= m;\n    r *= m; r ^= seed; r ^= r >> 11u; r *= m;\n    return float(r)/0xffffffffu;\n}\nfloat prng1() {return prng(gSeed);}\nvec2 prng2() {return vec2(prng1(), prng1());}\n\nvoid main()\n{\n    vec2 point = prng2();\n    if (length(point) < 1)\n        atomicAdd(ssiData[0], 1ul); // Inside a unit circle\n    atomicAdd(ssiData[1], 1ul); // Outside a unit circle\n    fragColor = vec4(point.rg, sin(iTime), 1);\n    \n    if (int(fragCoord.x) == 0 && int(fragCoord.y) == 0)\n        ssfData[0].x = 4*float(ssiData[0])/float(ssiData[1]);\n}",
                "uniforms": {}
            }
        }
    },
