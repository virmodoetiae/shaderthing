            "shader": {
                "fragmentSourceSize": 1276,
                "fragmentSource": "// Simple test demonstrating reading and writing to various types of\n// 1-channel storage textures (see Resources->Resource manager) with \n// various texture formats (e.g., unsigned integer ui, unsigned normalized \n// integer uni, float f). The textures are bound as image2D uniforms instead\n// of sampler uniforms to test image bindings\n\nvoid main()\n{\n    IF_FRAG_XY(0, 0)\n    {\n        // A value of 64 is written, but it is clamped in the 0-1 range\n        // when writing to fragColor\n        imageStore(ui, ivec2(1, 0), uvec4(64));\n        \n        // A value of 10 is required, but since this is a normalized\n        // unsigned integer format, it is clamped in the 0-1 range before\n        // writing to the texture (see Resources->Shared storage to inspect)\n        imageStore(uni, ivec2(1), uvec4(10));\n        \n        // A float format can store any value\n        imageStore(f, ivec2(0), vec4(.1389));\n    }\n    \n    ivec2 mc = ivec2(2*tc);\n    fragColor = vec4(0);\n    fragColor += imageLoad(ui, mc);\n    fragColor += imageLoad(uni, mc);\n    fragColor += imageLoad(f, mc);\n    \n    // Set in shared storage for inspection\n    ssfData[0].r = imageLoad(ui, ivec2(1, 0)).r;\n    ssfData[0].g = imageLoad(uni, ivec2(1)).r;\n    ssfData[0].b = imageLoad(f, ivec2(0)).r;\n}",
                "uniforms": {
                    "ui": {
                        "type": "image2D",
                        "shared": false,
                        "value": "ui"
                    },
                    "uni": {
                        "type": "image2D",
                        "shared": false,
                        "value": "uni"
                    },
                    "f": {
                        "type": "image2D",
                        "shared": false,
                        "value": "f"
                    }
                }
            }
        }
    },
